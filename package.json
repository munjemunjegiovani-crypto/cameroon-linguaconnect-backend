{
  "name": "cameroon-linguaconnect-backend",
  "version": "1.0.0",
  "description": "REST API for Cameroon LinguaConnect (Cameroon Culture Tongues)",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:setup": "tsx src/db/setup.ts",
    "db:setup:prod": "node dist/db/setup.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "pg": "^8.23.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.16.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3"
  }
}
